			<string>/Users/tsukadjed/Dropbox/Automation/applescript Folder/Keynote/resizeImages&amp;insertInKeynoteFrontDoc</string>
			<key>ActionUID</key>
			<integer>400018368</integer>
			<key>DisplayKind</key>
			<string>None</string>
			<key>HonourFailureSettings</key>
			<true/>
			<key>IncludeStdErr</key>
