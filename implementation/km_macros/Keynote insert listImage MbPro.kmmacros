			<key>StopOnFailure</key>
			<false/>
			<key>Text</key>
			<string>use AppleScript version "2.4" -- Yosemite (10.10) or later
use scripting additions
-- this is the script for working in MbPro with double Resolution
--the problem of Empty Lines in the list of images is solved in this applescript

--/Users/tsukadjed/Dropbox/Automation/applescript Folder/Keynote/resizeImages&amp;insertInKeynoteFrontDoc
property NameThisMasterSlide : "StudentKeynote"
set kmInst to system attribute "KMINSTANCE"
tell application "Keyboard Maestro Engine"
	set thisList to getvariable "snagit_imageList" instance kmInst
end tell
-- remove Empty lines in theseImageFiles
set theseImageFiles to paragraphs of thisList
if last item of theseImageFiles is "" then
	set theseImageFiles to items 1 thru -2 of theseImageFiles
end if
--resize images to y:600
--the resized images are stored in: /Users/tsukadjed/Dropbox/imageTransit_Keynote
repeat with i from 1 to (count theseImageFiles)
	set fileName to name of (info for (item i of theseImageFiles))
	set newFile to "/Users/tsukadjed/Dropbox/imageTransit_Keynote" &amp; "/" &amp; fileName
	do shell script ("sips --resampleHeight 1200" &amp; space &amp; (quoted form of (item i of theseImageFiles)) &amp; " --out " &amp; (quoted form of (newFile)))
	set item i of theseImageFiles to (POSIX file (newFile))
end repeat

-- verify the front Keynote document is the student's deck chosen by
-- rect_focus_keynote_student.sh (KM variable rect_targetDeck); never insert elsewhere
tell application "Keyboard Maestro Engine"
	set targetDeck to getvariable "rect_targetDeck" instance kmInst
end tell
if targetDeck is "" then error "rect_targetDeck is empty: the student's Keynote deck was not found"
if targetDeck ends with ".key" then set targetDeck to text 1 thru -5 of targetDeck
tell application "Keynote"
	if (count of documents) = 0 then error "No Keynote document is open"
	set frontName to name of front document
end tell
if frontName does not contain targetDeck then error "Front Keynote document is '" &amp; frontName &amp; "', expected '" &amp; targetDeck &amp; "'. Nothing inserted."

--convert applescript list to hsf files for Keynote
set listLength to length of theseImageFiles
--set theseImageFiles to items 2 thru -1 of theItemsList
--repeat with i from 1 to (count theseImageFiles)
--	set item i of theseImageFiles to (POSIX file (item i of theseImageFiles))
--end repeat

tell application "Keynote"
	activate
	--test SlideLayout name and add new empty slide
	tell the front document -- or "tell document 1"
		set NumbCurrentSlide to slide number of current slide
		set NumbLastSlideNumb to slide number of last slide
		set NamesMasterSlide to the name of every slide layout
		
		if NameThisMasterSlide is in the NamesMasterSlide then
			set thisSlide to make new slide with properties {base layout:slide layout NameThisMasterSlide}
		end if
	end tell
	repeat with i from 1 to the count of theseImageFiles
		set thisImageFile to item i of theseImageFiles
		--layoutName: StudentKeynote
		tell front document
			set thisSlide to make new slide with properties {base layout:slide layout NameThisMasterSlide}
			tell current slide
				set thisImage to make new image with properties {file:thisImageFile}
			end tell
		end tell
	end repeat
end tell</string>
