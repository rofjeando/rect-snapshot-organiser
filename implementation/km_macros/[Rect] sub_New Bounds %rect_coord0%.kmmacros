								<key>Text</key>
								<string>#!/usr/bin/env python3
import os
rect_coord0 = os.environ["KMVAR_rect_coord0"]
rect_offset0 = os.environ["KMVAR_rect_offset0"]
coords = list(map(int, rect_coord0.split(',')))
offset = int(rect_offset0)
coords[0] += offset
new_rect_coord0 = ",".join(map(str, coords))
print(new_rect_coord0)

</string>
