					<false/>
					<key>Text</key>
					<string>--/Users/tsukadjed/Dropbox/Automation/applescript Folder/Keynote/resizeImages&amp;insertInKeynoteFrontDoc

set kmInst to system attribute "KMINSTANCE"
tell application "Keyboard Maestro Engine"
	set thisList to getvariable "snagit_imageList" instance kmInst
end tell
set theseImageFiles to paragraphs of thisList
--resize images to y:600
--the resized images are stored in: /Users/tsukadjed/Dropbox/imageTransit_Keynote
repeat with i from 1 to (count theseImageFiles)
	set fileName to name of (info for (item i of theseImageFiles))
	set newFile to "/Users/tsukadjed/Dropbox/imageTransit_Keynote" &amp; "/" &amp; fileName
	do shell script ("sips --resampleHeight 600" &amp; space &amp; (quoted form of (item i of theseImageFiles)) &amp; " --out " &amp; (quoted form of (newFile)))
	set item i of theseImageFiles to (POSIX file (newFile))
end repeat

--convert applescript list to hsf files for Keynote
set listLength to length of theseImageFiles
--set theseImageFiles to items 2 thru -1 of theItemsList
--repeat with i from 1 to (count theseImageFiles)
--	set item i of theseImageFiles to (POSIX file (item i of theseImageFiles))
--end repeat

tell application "Keynote"
	activate
	repeat with i from 1 to the count of theseImageFiles
		set thisImageFile to item i of theseImageFiles
		--layoutName: StudentKeynote
		tell front document
			set thisSlide to make new slide with properties {base layout:slide layout "StudentKeynote"}
			tell current slide
				set thisImage to make new image with properties {file:thisImageFile}
			end tell
		end tell
	end repeat
end tell</string>
