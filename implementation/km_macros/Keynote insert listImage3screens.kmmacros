							<key>Application</key>
							<dict>
								<key>BundleIdentifier</key>
								<string>com.apple.Keynote</string>
								<key>Name</key>
								<string>Keynote</string>
								<key>NewFile</key>
								<string>/Applications/Keynote Creator Studio.app</string>
							</dict>
