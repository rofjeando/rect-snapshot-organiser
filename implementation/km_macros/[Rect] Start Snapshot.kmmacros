							<key>MacroActionType</key>
							<string>ExecuteAppleScript</string>
							<key>Path</key>
							<string></string>
							<key>Text</key>
							<string>tell application "System Events"
	
	-- Look for Keyboard Maestro Engine specifically
	if exists process "Keyboard Maestro Engine" then
		set kmProcess to process "Keyboard Maestro Engine"
		set kmFound to true
		
		-- Get all KM windows
		set kmWindows to every window of kmProcess
		perform action "AXRaise" of window "Keyboard Maestro User Input" of application process "Keyboard Maestro Engine"
	end if
end tell</string>
