							<key>Source</key>
							<string>Nothing</string>
							<key>Text</key>
							<string>DIR="/Users/tsukadjed/Library/Caches/imageTransit_temp"
maxw=0
maxh=0

for f in "$DIR"/*.jpg; do
  [ -e "$f" ] || continue
  w=$(sips -g pixelWidth "$f" 2&gt;/dev/null | awk '/pixelWidth/ {print $2}')
  h=$(sips -g pixelHeight "$f" 2&gt;/dev/null | awk '/pixelHeight/ {print $2}')
  [ -n "$w" ] &amp;&amp; [ "$w" -gt "$maxw" ] &amp;&amp; maxw="$w"
  [ -n "$h" ] &amp;&amp; [ "$h" -gt "$maxh" ] &amp;&amp; maxh="$h"
done

echo "$maxw,$maxh"</string>
