						<dict>
							<key>ActionColor</key>
							<string>Purple</string>
							<key>ActionName</key>
							<string>MaxH and MaxW of all snapshots stored in /Users/tsukadjed/Library/Caches/imageTransit_temp</string>
							<key>ActionUID</key>
							<integer>20022407</integer>
							<key>DisplayKind</key>
							<string>Variable</string>
