							<key>Text</key>
							<string>#!/bin/zsh
DIR="/Users/tsukadjed/Library/Caches/imageTransit_temp"

# Safety guard (prevents disasters if DIR is empty or "/")
[[ -n "$DIR" &amp;&amp; "$DIR" != "/" ]] || exit 2
[[ -d "$DIR" ]] || exit 0

find "$DIR" -type f -print0 | xargs -0 rm -f
exit 0</string>
